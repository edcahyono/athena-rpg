# Required — server-side only, never exposed to the game client
ANTHROPIC_API_KEY=sk-ant-...

# Models (defaults shown)
# CHAT_MODEL=claude-sonnet-5
# LIGHT_MODEL=claude-haiku-4-5-20251001

# Server
# PORT=3002
# MAX_TOKENS=900

# Optional Voyage embeddings for RAG (BM25 works without it)
# VOYAGE_API_KEY=pa-...

# Admin / QA mode — the code that unlocks every gate and auto-passes every
# check from the title screen's admin button.
# ⚠ SET ADMIN_CODE IN PRODUCTION. The default below is in the public repo,
# so anyone reading it could skip the entire engagement.
# ADMIN_CODE=THUxDeloitte

# Coach console (/coach) — edits the RAG corpus and rebuilds the persona stores.
# ⚠ SET COACH_ADMINS IN PRODUCTION. Without it the console falls back to the
# published default below, which anyone reading this repo could use to rewrite
# the grounding corpus. Format: "user:pass,user2:pass2".
# COACH_ADMINS=Athena:deloitte168
# Set to false to hide the console entirely before handing the app to learners.
# COACH_MODE=true
